# Copy this file to .env and set only the credentials for services you use.

# Local Ollama endpoint (Docker Compose overrides this for the CLI container).
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
OLLAMA_KEEP_ALIVE=5m
OLLAMA_MIN_MEMORY_GB=

# Vision provider: ollama, mlx, or qwen3-vl (MLX providers require native Apple Silicon).
VISION_PROVIDER=ollama
MLX_VISION_MODEL=mlx-community/SmolVLM2-2.2B-Instruct-mlx
QWEN3_VL_MODEL=mlx-community/Qwen3-VL-4B-Instruct-4bit

# Text planning and optional embedding model configuration.
VIDEO_PLANNER_MODEL=qwen2.5:1.5b
VIDEO_PLANNER_MIN_MEMORY_GB=
FOOTAGE_EMBEDDING_MODEL=

# Optional local transcription resource limits.
WHISPER_MIN_MEMORY_GB=
WHISPER_MIN_VRAM_GB=

# Optional hosted soundtrack providers; leave blank unless using these features.
SOUNDSTRIPE_API_KEY=
STABILITY_API_KEY=
